generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationTier {
  free
  developer
  enterprise
}

enum AgentStatus {
  active
  inactive
  suspended
}

enum TransactionStatus {
  pending
  escrowed
  settled
  disputed
  refunded
  failed
}

enum DisputeStatus {
  open
  under_review
  resolved_buyer
  resolved_seller
  closed
}

/// Monetary balances are stored as INTEGER cents (BigInt). Never use float/decimal for money.
model Organization {
  id           String           @id @db.Uuid
  name         String           @db.VarChar(128)
  slug         String           @unique @db.VarChar(64)
  tier         OrganizationTier @default(free)
  balanceCents BigInt           @default(0) @map("balance_cents")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  agents    Agent[]
  apiKeys   ApiKey[]
  webhooks  Webhook[]
  auditLogs AuditLog[]

  stripeConnectAccount StripeConnectAccount?
  subscription         Subscription?
  invoices             Invoice[]
  usageRecords         UsageRecord[]
  platformFeeLedgers   PlatformFeeLedger[]

  @@map("organizations")
}

model Agent {
  id              String      @id @db.Uuid
  orgId           String      @map("org_id") @db.Uuid
  name            String      @db.VarChar(128)
  publicKey       String      @unique @map("public_key") @db.Text
  capabilities    String[]    @default([]) @map("capabilities")
  pricingModel    String?     @map("pricing_model") @db.VarChar(32)
  unitPriceCents  BigInt?     @map("unit_price_cents")
  /// Spendable wallet in integer cents. Never expose in API responses.
  balanceCents    BigInt      @default(0) @map("balance_cents")
  reputationScore Decimal     @default(0.5) @map("reputation_score") @db.Decimal(5, 4)
  status          AgentStatus @default(active)
  /// Encrypted at rest via field-level AES-256-GCM (PII / sensitive attrs).
  metadata        Json?       @default("{}")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  org                  Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactionsAsBuyer  Transaction[]     @relation("BuyerTransactions")
  transactionsAsSeller Transaction[]     @relation("SellerTransactions")
  reputationEvents     ReputationEvent[]
  disputesRaised       Dispute[]

  @@index([orgId, status])
  @@index([reputationScore])
  @@map("agents")
}

model ApiKey {
  id         String    @id @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  name       String    @db.VarChar(128)
  keyPrefix  String    @map("key_prefix") @db.VarChar(16)
  keyHash    String    @map("key_hash") @db.VarChar(255)
  scopes     String[]  @default(["read:agents", "read:transactions", "write:transactions"])
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model Transaction {
  id             String            @id @db.Uuid
  buyerId        String            @map("buyer_id") @db.Uuid
  sellerId       String            @map("seller_id") @db.Uuid
  amountCents    BigInt            @map("amount_cents")
  feeCents       BigInt            @map("fee_cents")
  description    String?           @db.VarChar(512)
  metadata       Json?             @default("{}")
  status         TransactionStatus @default(pending)
  idempotencyKey String?           @unique @map("idempotency_key") @db.VarChar(64)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  settledAt      DateTime?         @map("settled_at") @db.Timestamptz(3)

  escrow  Escrow?
  dispute Dispute?
  buyer   Agent    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller  Agent    @relation("SellerTransactions", fields: [sellerId], references: [id])

  platformFeeLedger PlatformFeeLedger?

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
  @@index([status, createdAt])
  @@index([idempotencyKey])
  @@map("transactions")
}

model Escrow {
  id            String    @id @db.Uuid
  transactionId String    @unique @map("transaction_id") @db.Uuid
  amountCents   BigInt    @map("amount_cents")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  released      Boolean   @default(false)
  releasedAt    DateTime? @map("released_at") @db.Timestamptz(3)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([expiresAt, released])
  @@map("escrow")
}

model Dispute {
  id            String        @id @db.Uuid
  transactionId String        @unique @map("transaction_id") @db.Uuid
  raisedById    String        @map("raised_by_id") @db.Uuid
  reason        String        @db.VarChar(512)
  status        DisputeStatus @default(open)
  resolution    String?       @db.VarChar(1024)
  resolvedAt    DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  raisedBy    Agent       @relation(fields: [raisedById], references: [id])

  @@index([status, createdAt])
  @@map("disputes")
}

model AuditLog {
  id            String   @id @db.Uuid
  orgId         String?  @map("org_id") @db.Uuid
  action        String   @db.VarChar(64)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String   @map("entity_id") @db.Uuid
  metadata      Json?    @default("{}")
  /// HMAC-SHA256 hex of previousHash + canonical payload + timestamp.
  integrityHash String   @map("integrity_hash") @db.VarChar(64)
  previousHash  String?  @map("previous_hash") @db.VarChar(64)
  actorType     String   @map("actor_type") @db.VarChar(32)
  actorId       String?  @map("actor_id") @db.Uuid
  changes       Json?    @default("{}")
  result        String   @db.VarChar(32)
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model ReputationEvent {
  id        String   @id @db.Uuid
  agentId   String   @map("agent_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(32)
  delta     Decimal  @db.Decimal(5, 4)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("reputation_events")
}

model Webhook {
  id        String   @id @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  url       String   @db.VarChar(2048)
  /// Encrypted at rest (AES-256-GCM envelope JSON).
  secret    String   @db.Text
  events    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
  @@map("webhooks")
}

enum StripeConnectStatus {
  pending
  onboarding
  active
  restricted
  rejected
}

model StripeConnectAccount {
  id                     String              @id @db.Uuid
  orgId                  String              @unique @map("org_id") @db.Uuid
  stripeAccountId        String              @unique @map("stripe_account_id") @db.VarChar(255)
  status                 StripeConnectStatus @default(pending)
  chargesEnabled         Boolean             @default(false) @map("charges_enabled")
  payoutsEnabled         Boolean             @default(false) @map("payouts_enabled")
  onboardingUrl          String?             @map("onboarding_url") @db.Text
  onboardingUrlExpiresAt DateTime?           @map("onboarding_url_expires_at") @db.Timestamptz(3)
  defaultCurrency        String              @default("usd") @map("default_currency") @db.VarChar(3)
  country                String              @default("us") @map("country") @db.VarChar(2)
  requirementsJson       Json?               @map("requirements_json")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@index([status, chargesEnabled])
  @@map("stripe_connect_accounts")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

model Subscription {
  id                   String             @id @db.Uuid
  orgId                String             @unique @map("org_id") @db.Uuid
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId     String?            @map("stripe_customer_id") @db.VarChar(255)
  tier                 OrganizationTier
  status               SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart   DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd     DateTime           @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  usageRecords UsageRecord[]

  @@index([orgId, status])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

model Invoice {
  id              String        @id @db.Uuid
  orgId           String        @map("org_id") @db.Uuid
  subscriptionId  String?       @map("subscription_id") @db.Uuid
  stripeInvoiceId String?       @unique @map("stripe_invoice_id") @db.VarChar(255)
  invoiceNumber   String        @unique @map("invoice_number") @db.VarChar(32)
  status          InvoiceStatus @default(draft)
  amountDueCents  BigInt        @map("amount_due_cents")
  amountPaidCents BigInt        @default(0) @map("amount_paid_cents")
  currency        String        @default("usd") @map("currency") @db.VarChar(3)
  pdfUrl          String?       @map("pdf_url") @db.Text
  hostedUrl       String?       @map("hosted_url") @db.Text
  dueDate         DateTime?     @map("due_date") @db.Timestamptz(3)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  lineItems       Json          @map("line_items")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([orgId, status])
  @@index([invoiceNumber])
  @@map("invoices")
}

enum UsageMeterType {
  api_calls
  transactions
  transaction_volume_cents
  agents
  webhooks
  disputes
}

model UsageRecord {
  id             String         @id @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  subscriptionId String         @map("subscription_id") @db.Uuid
  meterType      UsageMeterType @map("meter_type")
  quantity       Int            @default(0)
  amountCents    BigInt?        @map("amount_cents")
  billingPeriod  String         @map("billing_period") @db.VarChar(7)
  source         String         @map("source") @db.VarChar(32)
  sourceId       String?        @map("source_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([orgId, billingPeriod, meterType])
  @@index([subscriptionId, billingPeriod])
  @@map("usage_records")
}

/// Platform take on each transaction (integer cents only).
model PlatformFeeLedger {
  id               String    @id @db.Uuid
  transactionId    String    @unique @map("transaction_id") @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  grossAmountCents BigInt    @map("gross_amount_cents")
  platformFeeCents BigInt    @map("platform_fee_cents")
  netAmountCents   BigInt    @map("net_amount_cents")
  feeBasisPoints   Int       @map("fee_basis_points")
  stripeTransferId String?   @map("stripe_transfer_id") @db.VarChar(255)
  transferredAt    DateTime? @map("transferred_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transaction Transaction  @relation(fields: [transactionId], references: [id])

  @@index([orgId, createdAt])
  @@index([transactionId])
  @@map("platform_fee_ledger")
}
