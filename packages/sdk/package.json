{
  "name": "@cognistream/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for CogniStream AI-to-AI payment infrastructure",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.6",
    "msw": "^2.7.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cognistream",
    "ai-agents",
    "payments",
    "escrow",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cognistream-org/cognistream-engine-.git",
    "directory": "packages/sdk"
  }
}
