{
  "name": "cognistream-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High-performance AI-to-AI payment infrastructure and escrow engine",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @cognistream/api --filter @cognistream/web --filter @cognistream/docs run dev",
    "dev:docs": "pnpm --filter @cognistream/docs dev",
    "dev:api": "pnpm --filter @cognistream/api dev",
    "dev:web": "pnpm --filter @cognistream/web dev",
    "build": "pnpm --filter @cognistream/shared build && pnpm --filter @cognistream/sdk build && pnpm --filter @cognistream/api build && pnpm --filter @cognistream/web build && pnpm --filter @cognistream/docs build",
    "build:docs": "pnpm --filter @cognistream/docs build",
    "build:sdk": "pnpm --filter @cognistream/sdk build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @cognistream/api db:generate",
    "db:migrate": "pnpm --filter @cognistream/api db:migrate",
    "db:seed": "pnpm --filter @cognistream/api db:seed",
    "db:seed:demo": "pnpm --filter @cognistream/api db:seed:demo",
    "db:studio": "pnpm --filter @cognistream/api db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:demo": "docker compose -f docker-compose.demo.yml up --build",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.12",
      "vite": ">=6.3.5"
    }
  }
}
