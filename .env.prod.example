# Production environment template — copy to .env.prod and fill secrets.
# NEVER commit .env.prod

NODE_ENV=production
LOG_LEVEL=info

# Postgres
POSTGRES_USER=cognistream
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cognistream

# API
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://cognistream:change-me-strong-password@postgres:5432/cognistream?schema=public
REDIS_URL=redis://redis:6379

# Web (build-time public URL for browser → API via nginx)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Optional Codecov (CI)
# CODECOV_TOKEN=
